      "layer": "data_retrieval",
      "description": "查询检验结果以获取肿瘤标志物（CEA, CYFRA21-1, CA125）的基线与随访数值",
      "eval_method": "category_query",
      "params": {
        "category": "检验",
        "description": "查询检验事件"
      }
    },
    {
      "checkpoint_id": "cp3_reasoning_baseline",
      "layer": "clinical_reasoning",
      "description": "是否识别了可评估病灶并建立了治疗前后的对比依据（如CT影像对比或标志物数值对比）",
      "eval_method": "llm_judge",
      "params": {
        "question": "回答中是否明确指出了用于评估疗效的可评估病灶（如双肺弥漫性病灶）或关键肿瘤标志物，并描述了其治疗前后的变化趋势（如明显退缩或数值下降）？",
        "expected": "是，识别了双肺弥漫性病灶的退缩或CEA/CYFRA21-1/CA125的下降作为对比依据"
      }
    },
    {
      "checkpoint_id": "cp4_outcome_conclusion",
      "layer": "outcome_check",
      "description": "最终疗效结论是否正确判定为PR",
      "eval_method": "field_match",
      "params": {
        "field": "疗效结论",
        "expected": "PR"
      }
    },
    {
      "checkpoint_id": "cp5_doc_structure",
      "layer": "documentation",
      "description": "输出文档是否包含所有要求的结构化字段",
      "eval_method": "llm_judge",
      "params": {
        "question": "输出文件 output/diagnosis_report.md 是否包含以下四个结构化字段：'评估时点前主要治疗'、'可评估病灶情况'、'疗效结论'、'判定依据'？",
        "expected": "包含全部四个字段"
      }
    }
  ]
}